# =============================================================================
# Frontend Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment
#
# VITE_API_BASE_URL: The backend API address
#   Development: /api/v1 (recommended; Vite proxies to the backend)
#   Local direct backend: http://localhost:8000/api/v1
#   Production: https://your-domain.com/api/v1
#
# Important: Vite automatically prefixes env vars with VITE_
# So VITE_API_BASE_URL is the correct name (not API_BASE_URL)
# =============================================================================

VITE_API_BASE_URL=/api/v1
VITE_API_KEY=
VITE_USER_ID=

# Firebase Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=finheal-59748.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=finheal-59748
VITE_FIREBASE_STORAGE_BUCKET=finheal-59748.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=580523435709
VITE_FIREBASE_APP_ID=1:580523435709:web:532e43023ccc670ff239d4
VITE_FIREBASE_MEASUREMENT_ID=G-PKC2ZFWW9B

